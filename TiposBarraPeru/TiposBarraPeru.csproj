<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Revit 2027 corre sobre .NET 10. Para 2025/2026 seria net8.0-windows. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>TiposBarraPeru</AssemblyName>
    <RootNamespace>TiposBarraPeru</RootNamespace>
    <!-- Revit ya carga sus propias DLL: no copiar las de los paquetes al output -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2027.*" ExcludeAssets="runtime" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2027.*" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reglas puras (catalogo, config, E.060). Su DLL se despliega junto a esta. -->
    <ProjectReference Include="..\TiposBarraPeru.Reglas\TiposBarraPeru.Reglas.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Copia automatica al directorio de add-ins de Revit al compilar en Debug (solo Windows) -->
  <Target Name="CopyToRevit" AfterTargets="Build" Condition="'$(Configuration)'=='Debug' AND '$(OS)'=='Windows_NT'">
    <PropertyGroup>
      <AddinDir>$(AppData)\Autodesk\Revit\Addins\2027\TiposBarraPeru\</AddinDir>
    </PropertyGroup>
    <MakeDir Directories="$(AddinDir)" />
    <Copy SourceFiles="$(TargetPath);$(TargetDir)TiposBarraPeru.Reglas.dll;$(ProjectDir)config.json" DestinationFolder="$(AddinDir)" />
    <Copy SourceFiles="$(ProjectDir)TiposBarraPeru.addin" DestinationFolder="$(AppData)\Autodesk\Revit\Addins\2027\" />
  </Target>

</Project>
